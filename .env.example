# Postgres (Neon / Supabase / local)
DATABASE_URL=postgres://phonestore:phonestore@localhost:5432/phonestore

# Admin panel
ADMIN_PASSWORD=change-me-please
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Public store info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=PhoneStore

# Optional: order emails via Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM="PhoneStore <orders@your-domain.com>"
ORDER_NOTIFY_EMAIL=
