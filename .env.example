# Postgres (Neon / Supabase / local)
DATABASE_URL=postgres://phonestore:phonestore@localhost:5432/phonestore

# Admin panel
ADMIN_PASSWORD=change-me-please
AUTH_SECRET=generate-a-long-random-string-at-least-32-chars

# Public store info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=ElectroSalam

# Optional: order emails via Resend (https://resend.com)
# Order e-mails over SMTP (leave SMTP_HOST empty to skip sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true   # only for providers that need implicit TLS on a non-465 port
MAIL_FROM="ElectroSalam <orders@your-domain.com>"
ORDER_NOTIFY_EMAIL=

# Bank account shown to customers for the 100 DH order deposit (bank transfer)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_HOLDER=
NEXT_PUBLIC_BANK_RIB=

# Payzone card payment of the deposit (inactive until the integration is completed)
PAYZONE_PAYWALL_URL=
PAYZONE_MERCHANT_ACCOUNT=
PAYZONE_SECRET_KEY=
PAYZONE_NOTIFICATION_KEY=
